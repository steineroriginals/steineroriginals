{
  "name": "steineroriginals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rudolf Steiner lecture catalog (SSOT), originals, and reference tooling",
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx src/scripts/validate_catalog.ts",
    "stats": "tsx src/scripts/stats_catalog.ts",
    "sort": "tsx src/scripts/sort_lectures_by_id.ts",
    "export:csv": "tsx src/scripts/yaml_to_csv.ts",
    "maintain:ga-suggest": "tsx src/scripts/maintain-lecture-catalog/suggest_ga_for_missing.ts",
    "maintain:ga-toc": "tsx src/scripts/maintain-lecture-catalog/add_ga_from_ga_pdf_toc.ts",
    "maintain:ga-rsarchive": "tsx src/scripts/maintain-lecture-catalog/check_ga_against_rsarchive.ts",
    "upload:originals": "tsx src/scripts/upload_originals_to_r2.ts",
    "link:manuscripts": "tsx src/scripts/link_manuscripts_to_catalog.ts",
    "build:website-data": "tsx src/website/scripts/build-catalog-index.ts",
    "dev:website": "yarn build:website-data && vite --config src/website/vite.config.ts",
    "build:website": "yarn build:website-data && vite build --config src/website/vite.config.ts",
    "preview:website": "vite preview --config src/website/vite.config.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "js-yaml": "^4.1.0"
  }
}
