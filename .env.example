# Cloudflare R2 — steineroriginals originals (never commit .env)
# Create a dedicated bucket (e.g. steineroriginals-pdfs), separate from Uranos.
# Dashboard: R2 → bucket → Settings → Public access → enable r2.dev or custom domain
# API tokens: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=steineroriginals-pdfs
PUBLIC_R2_BASE_URL=https://pub-xxxxxxxx.r2.dev
